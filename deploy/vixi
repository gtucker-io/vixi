set -eo pipefail

ALL="orchestrator monitor sched-inline sched-tekton sched-tekton-kvm"
DEPLOY_ORCHESTRATOR=
DEPLOY_MONITOR=
DEPLOY_INLINE=
DEPLOY_MIRROR=
DEPLOY_TEKTON=
DEPLOY_KBUILD=
DEPLOY_KBOOT=

[ $# == 0 ] && OPTS=${ALL} || OPTS=$@

echo "Options: ${OPTS}"

for opt in ${OPTS}; do
    case "${opt}" in
        orchestrator)
            DEPLOY_ORCHESTRATOR=yes
            ;;
        monitor)
            DEPLOY_MONITOR=yes
            ;;
        sched-inline)
            DEPLOY_INLINE=yes
            DEPLOY_MIRROR=yes
            ;;
        sched-tekton)
            DEPLOY_TEKTON=yes
            DEPLOY_KBUILD=yes
            DEPLOY_MIRROR=yes
            ;;
        sched-tekton-kvm)
            DEPLOY_TEKTON=yes
            DEPLOY_KBOOT=yes
            ;;
        *)
            echo "Unknown option: ${opt}, aborting"
            echo "Available options: ${ALL}"
            exit 1
            ;;
    esac
done

echo
kubectl apply -f k8s/namespace.yaml

[ -d secrets ] || {
    echo "Secrets directory not found, aborting"
    exit 1
}

(
    cd secrets
    [ -f api-key/credentials.json ] || {
        echo "Missing secrets/api-key/credentials.json, aborting"
        exit 1
    }
    [ -f api-key/settings.toml ] || {
        echo "Missing secrets/api-key/settings.toml, aborting"
        exit 1
    }
    [ -f api-key/id_rsa_vixi ] || {
        echo "Missing secrets/api-key/id_rsa_vixi, aborting"
        exit 1
    }
    kubectl -n vixi get secret api-key > /dev/null 2>&1 || {
        echo "Creating secret with Renelick API key and settings"
        kubectl create secret generic api-key \
            --namespace=vixi \
            --from-file=credentials.json=api-key/credentials.json \
            --from-file=settings.toml=api-key/settings.toml \
            --from-file=id_rsa_vixi=api-key/id_rsa_vixi
    }
)

echo
cronjobs=$(kubectl get cronjob -o name)
[ -n "$cronjobs" ] && {
    echo "Deleting old cronjobs..."
    kubectl delete $cronjobs
}
deployments=$(kubectl get deploy -o name | grep -v el-) || true
[ -n "$deployments" ] && {
    echo "Deleting old deployments..."
    kubectl delete $deployments
}
jobs=$(kubectl get job -o name | grep  -e 'init-\(sandbox\|mirror\)') || true
[ -n "$jobs" ] && {
    echo "Deleting stale init jobs..."
    kubectl delete $jobs
}
tasks=$(kubectl get taskrun -o name | grep 'init-kboot') || true
[ -n "$tasks" ] && {
    echo "Deleting stale init tasks..."
    kubectl delete $tasks
}

echo -e "\nDeploying sandbox..."
kubectl apply -f k8s/sandbox.yaml
kubectl wait --for=condition=complete --timeout=15m job init-sandbox

[ -n "${DEPLOY_TEKTON}" ] && {
    echo -e "\nDeploying Tekton resources..."
    kubectl apply -f tekton/triggers.yaml
    kubectl apply -f tekton/garbage.yaml
}
[ -n "${DEPLOY_KBUILD}" ] && {
    kubectl apply -f tekton/kbuild-tasks.yaml
    kubectl apply -f tekton/kbuild-pipeline.yaml
    kubectl apply -f tekton/kunit-pipeline.yaml
}
[ -n "${DEPLOY_KBOOT}" ] && {
    kubectl apply -f tekton/kboot-volume.yaml
    kubectl apply -f tekton/kboot-pipeline.yaml
}

echo -e "\nInitialising resources..."
[ -n "${DEPLOY_MIRROR}" ] && kubectl create -f k8s/init-mirror.yaml
[ -n "${DEPLOY_KBOOT}" ] && kubectl create -f tekton/kboot-init.yaml

jobs=$(kubectl get job -o name | grep 'init-mirror') || true
[ -n "$jobs" ] && {
    echo "Waiting for init jobs to complete..."
    kubectl wait --for=condition=complete --timeout=60m $jobs
}

tasks=$(kubectl get taskrun -o name | grep 'init-kboot') || true
[ -n "$tasks" ] && {
    echo "Waiting for init tasks to complete..."
    kubectl wait --for=condition=succeeded --timeout=15m $tasks
}
if [ -n "${DEPLOY_MIRROR}" ]; then
    echo "Updating mirrors for each tree..."
    for tree in torvalds next gtucker; do
        task=$(kubectl create -f tekton/mirror-${tree}.yaml | cut -d\  -f1)
        echo "* ${tree}"
        kubectl wait --for=condition=succeeded --timeout=15m ${task}
    done
fi

echo -e "\nDeploying services..."
[ -n "${DEPLOY_ORCHESTRATOR}" ] && {
    kubectl apply -f k8s/orchestrator.yaml
}
[ -n "${DEPLOY_MONITOR}" ] && {
    kubectl apply -f k8s/monitor.yaml
}
[ -n "${DEPLOY_INLINE}" ] && {
    kubectl apply -f k8s/sched-inline.yaml
}
[ -n "${DEPLOY_KBUILD}" ] && {
    kubectl apply -f k8s/sched-tekton.yaml
}
[ -n "${DEPLOY_KBOOT}" ] && {
    kubectl apply -f k8s/sched-tekton-kvm.yaml
}

deploy=$(kubectl get deploy -o name) || true
[ -n "$deploy" ] && {
    echo -e "\nWaiting for deployments..."
    kubectl wait --for=condition=available --timeout=15m $deploy
}

echo
kubectl get pods

exit 0
