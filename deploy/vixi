set -eo pipefail

echo "Deploying Kubernetes resources..."
kubectl apply -f tekton/namespace.yaml
kubectl apply -f tekton/volumes.yaml

echo "Deploying Tekton tasks and pipelines..."
kubectl apply -f tekton/kbuild.yaml

echo "Initialising resources..."
kubectl create -f tekton/kbuild-init.yaml

exit 0
