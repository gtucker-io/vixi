set -eo pipefail

URL="https://storage.googleapis.com/tekton-releases/"

echo "Deploying pipelines..."
kubectl apply -f "$URL"pipeline/previous/v1.2.0/release.yaml

echo "Deploying dashboard..."
kubectl apply -f "$URL"dashboard/previous/v0.59.0/release.yaml

echo "Deploying triggers..."
kubectl apply -f "$URL"triggers/previous/v0.32.0/release.yaml
kubectl apply -f "$URL"triggers/previous/v0.32.0/interceptors.yaml

echo "Patching feature flags..."
kubectl -n tekton-pipelines get configmap feature-flags -o yaml \
    > k8s/tekton/feature-flags.yaml
kubectl apply -k k8s/tekton
rm k8s/tekton/feature-flags.yaml

echo "Waiting for deployments..."
kubectl wait -n tekton-pipelines deployment \
    tekton-pipelines-webhook --for condition=Available --timeout 10m
kubectl wait -n tekton-pipelines deployment \
    tekton-dashboard --for condition=Available --timeout 10m
kubectl wait -n tekton-pipelines deployment \
    tekton-triggers-webhook --for condition=Available --timeout 10m

kubectl -n tekton-pipelines get pods

exit 0
