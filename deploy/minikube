set -eo pipefail

which minikube > /dev/null 2>&1 || {
    which dpkg || {
        echo "MiniKube not found, please install it:"
        echo https://minikube.sigs.k8s.io/docs/start/
        exit 1
    }
    echo Installing MiniKube for Debian
    [ -f minikube_latest_amd64.deb ] || {
        which curl > /dev/null || {
            sudo apt update && sudo apt install -y curl
        }
        curl -LO https://storage.googleapis.com/minikube/releases/latest/minikube_latest_amd64.deb
    }
    ls -l minikube_latest_amd64.deb
    sudo dpkg -i minikube_latest_amd64.deb
}

minikube version
minikube start --cpus=2 --memory=4096 --mount
minikube addons enable metrics-server

kubectl label node/minikube vixi/app=true
kubectl label node/minikube vixi/worker=true
kubectl label node/minikube vixi/kvm-worker=true

kubectl config set-context --current --namespace=vixi

exit 0
