set -eo pipefail

PROJECT="${1}"
CLUSTER="${2}"
LOCATION="${3}"

[ -n "$PROJECT" ] && [ -n "$CLUSTER" ] && [ "$LOCATION" ] || {
    echo "Usage: $0 PROJECT CLUSTER LOCATION"
}

echo "Project:   $PROJECT"
echo "Cluster:   $CLUSTER"
echo "Location:  $LOCATION"

found_cluster=$(
    gcloud container clusters list --filter="$CLUSTER" --format="value(NAME)"
)

if [ -n "$found_cluster" ]; then
    echo "Cluster already exists, not creating."
else
    echo "Creating cluster with default node pool..."
    gcloud container clusters create "${CLUSTER}" \
        --location="${LOCATION}" \
        --workload-pool="${PROJECT}".svc.id.goog \
        --workload-metadata=GKE_METADATA \
        --machine-type=e2-medium \
        --disk-type=pd-standard \
        --node-labels=vixi/default=true \
        --num-nodes=3
fi

echo "Getting cluster credentials..."
gcloud container clusters get-credentials "${CLUSTER}" --location "${LOCATION}"

found_pool=$(
  gcloud container node-pools list \
      --cluster="$CLUSTER" --location="$LOCATION" \
      --filter=worker-pool --format="value(NAME)"
)

if [ -n "$found_pool" ]; then
    echo "Worker pool already exists, not creating."
else
    # ToDo: consider using c3d-standard-8-lssd with local workspace
    echo "Creating worker pool..."
        gcloud container node-pools create worker-pool \
            --cluster="${CLUSTER}" \
            --location="${LOCATION}" \
            --workload-metadata=GKE_METADATA \
            --machine-type=c3d-standard-4 \
            --disk-type=pd-balanced \
            --disk-size=100 \
            --enable-autoscaling \
            --total-min-nodes=0 \
            --total-max-nodes=8 \
            --num-nodes=0 \
            --node-labels=vixi/worker=true \
            --location-policy=ANY
fi

found_pool=$(
  gcloud container node-pools list \
      --cluster="$CLUSTER" --location="$LOCATION" \
      --filter=kvm-worker-pool --format="value(NAME)"
)

if [ -n "$found_pool" ]; then
    echo "KVM worker pool already exists, not creating."
else
    echo "Creating worker pool..."
        gcloud container node-pools create kvm-worker-pool \
            --cluster="${CLUSTER}" \
            --location="${LOCATION}" \
            --workload-metadata=GKE_METADATA \
            --enable-nested-virtualization \
            --image-type=UBUNTU_CONTAINERD \
            --machine-type=n2-highmem-2 \
            --disk-type=pd-standard \
            --disk-size=100 \
            --enable-autoscaling \
            --total-min-nodes=0 \
            --total-max-nodes=8 \
            --num-nodes=0 \
            --node-labels=vixi/kvm-worker=true \
            --location-policy=ANY
fi

kubectl get nodes

exit 0
